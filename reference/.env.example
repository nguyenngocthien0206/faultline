# Credentials for the reference stack. TEST ONLY: never put real secrets here.
#
# `make ref-up` copies this file to reference/.env the first time (that copy is
# gitignored). Edit reference/.env to change a value; docker compose and the
# integration tests both read it. Changing a value on an existing stack needs
# `make ref-down` first, because databases keep the credentials they were
# initialised with.

# Simulated business database (Postgres) that dlt extracts from.
SOURCE_DB_USER=faultline
SOURCE_DB_PASSWORD=faultline
SOURCE_DB_NAME=coffee

# Dagster's own storage (Postgres).
DAGSTER_DB_USER=dagster
DAGSTER_DB_PASSWORD=dagster
DAGSTER_DB_NAME=dagster

# Warehouse (ClickHouse).
CLICKHOUSE_USER=faultline
CLICKHOUSE_PASSWORD=faultline

# Landing bucket (RustFS, S3-compatible). Also the S3 console login.
S3_ACCESS_KEY=faultline
S3_SECRET_KEY=faultline-secret
